# Copy this file to:
#   /Users/smy/projects/blog/backend/.env
#
# If you already have a backend .env, merge the NOTEBOOKLM block into it
# instead of overwriting your existing database and app settings.
#
# NotebookLM Enterprise API uses a Bearer access token here, not a classic API key.
#
# Recommended preparation:
#   gcloud auth login
#   gcloud config set project YOUR_PROJECT_ID
#   export NOTEBOOKLM_ACCESS_TOKEN="$(gcloud auth print-access-token)"
#
# Recommended random agent token:
#   openssl rand -hex 32

# Basic backend settings you likely already have
PORT=3001
GIN_MODE=debug
SERVER_HOST=0.0.0.0
SERVER_TIMEOUT=30s

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=replace-with-your-mysql-password
DB_NAME=blog_db
DB_SSLMODE=disable
DB_TIMEZONE=Asia/Shanghai

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

JWT_SECRET=replace-with-your-jwt-secret
UPLOAD_PATH=/app/uploads

# NotebookLM block
NOTEBOOKLM_ENABLED=true
NOTEBOOKLM_MOCK_MODE=false
NOTEBOOKLM_API_BASE_URL=https://discoveryengine.googleapis.com
NOTEBOOKLM_PROJECT_NUMBER=123456789012
NOTEBOOKLM_LOCATION=global
NOTEBOOKLM_ACCESS_TOKEN=replace-with-output-of-gcloud-auth-print-access-token
NOTEBOOKLM_AGENT_TOKEN=replace-with-a-long-random-secret
NOTEBOOKLM_TIMEOUT=60s

# Optional:
# If you want to validate the full import flow before connecting real Google services,
# temporarily switch to:
# NOTEBOOKLM_ENABLED=false
# NOTEBOOKLM_MOCK_MODE=true
